# Axolotl environment - SHARED_CONTRACTS §10
# Copy to .env and fill in. NEVER commit .env; secrets live in the team vault.
# Placeholders only in this file.

# --- Gemini (Dev 1) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_THINKING_LEVEL=medium
GEMINI_EMBEDDING_MODEL=gemini-embedding-001   # 768/1536/3072 all available
EMBEDDING_DIMENSIONS=768

# Generate chunk descriptions and embeddings during import. Off imports much faster
# but leaves only keyword search working until POST /repositories/{id}/index is called.
INDEX_ON_IMPORT=true

# --- Search descriptions (Dev 3, #11) ---
# Add a model-written description to each chunk during import. Off (default), an import
# embeds chunks from their source alone, with no generate_content call.
# POST /repositories/{id}/index always adds descriptions.
INDEX_DESCRIPTIONS=false
# The model that writes descriptions: search chunk descriptions, and the module purposes
# in the generated docs (#39, one call per module, 14 for chess). Empty means
# GEMINI_MODEL, which spends Argon calls. Set a Flash model (e.g. gemini-3.8-flash) to
# keep Argon's quota for the agent.
GEMINI_DESCRIPTION_MODEL=
# Spaces description calls evenly to stay under the model's per-minute limit (free-tier
# Flash hit it after 8 calls). 0 means unpaced.
GEMINI_DESCRIPTIONS_PER_MINUTE=0

# --- MongoDB Atlas (Dev 3) ---
MONGODB_URI=
MONGODB_DATABASE=axolotl

# --- Sandbox runner (Dev 4) ---
RUNNER_MODE=trusted_docker         # trusted_docker | disabled
RUNNER_IMAGE=axolotl-runner:latest
# One image per interpreter (#22): python2_to_3 baselines on 2.7, verifies on 3.14.
RUNNER_IMAGE_PY27=axolotl-runner:py2.7
RUNNER_IMAGE_PY314=axolotl-runner:py3.14
ALLOW_ARBITRARY_CODE_EXECUTION=false
WORKSPACE_ROOT=./.axolotl_workspaces

# --- Frontend / orchestration (Dev 2) ---
FRONTEND_ORIGIN=http://localhost:5173
MAX_PATCH_ATTEMPTS=3
MAX_TOOL_CALLS_PER_UNIT=25
